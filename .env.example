# ===================================================
# IEDC TKIET - ENVIRONMENT CONFIGURATION TEMPLATE
# Innovation & Entrepreneurship Development Cell
# Tatyasaheb Kore Institute of Engineering & Technology
# ===================================================
# Copy this file to .env.local and configure your environment-specific credentials.
# DO NOT commit real secrets or credentials to version control.

# ---------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB with Mongoose)
# ---------------------------------------------------
# Example: mongodb://localhost:27017/iedc_tkiet or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/iedc_tkiet

# ---------------------------------------------------
# 2. SINGLE ADMINISTRATOR CREDENTIALS
# ---------------------------------------------------
# Administrator email address for CMS console login
ADMIN_EMAIL=admin@tkiet.ac.in

# Password hash generated via scrypt/crypto or bcrypt
# If not provided, development environment falls back to ADMIN_PASSWORD or development fallback with console warning.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# ---------------------------------------------------
# 3. SESSION SECURITY
# ---------------------------------------------------
# Cryptographic secret key used to sign HTTP-only session cookies
# Generate a strong 64-character random string in production
SESSION_SECRET=replace_with_a_secure_random_64_character_string_for_production

# ---------------------------------------------------
# 4. SMTP / EMAIL DISPATCH (Optional for Development)
# ---------------------------------------------------
# Outgoing mail configuration for forwarding contact inquiries
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@tkiet.ac.in
SMTP_PASSWORD=
CONTACT_RECEIVER_EMAIL=iedc@tkiet.ac.in

# ---------------------------------------------------
# 5. ENVIRONMENT & SITE URL
# ---------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
